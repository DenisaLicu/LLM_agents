
import json

from dotenv import load_dotenv
from openai import OpenAI

load_dotenv()
client = OpenAI()

# Fictional database
INVOICES = {
    "INV-2025-0042": {
        "invoice_id": "INV-2025-0042",
        "supplier": "ABC Ltd",
        "supplier_id": "SUP-001",
        "total": 2500,
        "currency": "EUR",
        "status": "unpaid",
    }
}

SUPPLIERS = {
    "SUP-001": {
        "supplier_id": "SUP-001",
        "name": "ABC Ltd",
        "status": "active",
    }
}


# Real Python functions
def get_invoice(invoice_id: str) -> dict:
    return INVOICES.get(
        invoice_id,
        {"error": "INVOICE_NOT_FOUND"},
    )

def get_supplier(supplier_id: str) -> dict:
    return SUPPLIERS.get(
        supplier_id,
        {"error": "SUPPLIER_NOT_FOUND"},
    )


# Tool interface exposed to the LLM
tools = [
    {
        "type": "function",
        "name": "get_invoice",
        "description": "Retrieve an invoice by its unique ID.",
        "parameters": {
            "type": "object",
            "properties": {
                "invoice_id": {"type": "string"},
            },
            "required": ["invoice_id"],
            "additionalProperties": False,
        },
        "strict": True,
    },
    {
    "type": "function",
    "name": "get_supplier",
    "description": "Retrieve a supplier and its current status by supplier ID.",
    "parameters": {
        "type": "object",
        "properties": {
            "supplier_id": {"type": "string"},
        },
        "required": ["supplier_id"],
        "additionalProperties": False,
    },
    "strict": True,
    }
]


question = (
    "Investigate invoice INV-2025-0042. "
    "Report its total, payment status, and whether its supplier is active."
)

messages = [{"role": "user", "content": question}]

tool_functions = {
    "get_invoice": get_invoice,
    "get_supplier": get_supplier,
}

MAX_ROUNDS = 5

for round_number in range(MAX_ROUNDS):
    print(f"\n--- Agent round {round_number + 1} ---")

    response = client.responses.create(
        model="gpt-5-mini",
        instructions=(
            "You are an invoice investigation assistant. "
            "Use tools to obtain business facts. "
            "Do not invent missing information. "
            "You may only investigate, not modify records."
        ),
        input=messages,
        tools=tools,
    )

    messages.extend(response.output)

    calls = [
        item for item in response.output
        if item.type == "function_call"
    ]

    # No tool requested: agent has finished.
    if not calls:
        print("\nFinal answer:")
        print(response.output_text)
        break

    # Leave room for a final response after tool execution.
    if round_number == MAX_ROUNDS - 1:
        print("Agent stopped: maximum rounds reached.")
        break

    for call in calls:
        print("Tool requested:", call.name)
        print("Arguments:", call.arguments)

        if call.name not in tool_functions:
            result = {"error": "TOOL_NOT_ALLOWED"}
        else:
            try:
                arguments = json.loads(call.arguments)
                result = tool_functions[call.name](**arguments)
            except (ValueError, TypeError) as exc:
                result = {
                    "error": "INVALID_TOOL_ARGUMENTS",
                    "message": str(exc),
                }

        print("Tool result:", result)

        messages.append({
            "type": "function_call_output",
            "call_id": call.call_id,
            "output": json.dumps(result),
        })

else:
    print("Agent stopped: maximum rounds reached.")
